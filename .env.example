# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CLOUD CONFIGURATION (Tempo Real Chão de Fábrica)
# Obtenha no console do Firebase: https://console.firebase.google.com/
# Crie um "Realtime Database" no modo de teste ou configure as regras de leitura/escrita.
VITE_FIREBASE_DATABASE_URL="https://seu-projeto-default-rtdb.firebaseio.com"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
